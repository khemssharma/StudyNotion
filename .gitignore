# Dependencies
node_modules/

# Environment files and secrets. ui/.env.production only holds public, client-side values and stays tracked.
.env
.env.*
!.env.example
!ui/.env.production

# Build and test output
ui/build/
dist/
coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (ml-service, pipelines). Trained artefacts in ml-service/models/ stay tracked: the service loads them.
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Load-test output from run-all.sh (the report generator and the sample report stay tracked)
load-tests/reports/*
!load-tests/reports/generate-report.js
!load-tests/reports/sample-report.html
!load-tests/reports/sample-summary.json

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
